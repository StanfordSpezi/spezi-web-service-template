realm: "{{ SPEZI_SERVICE_NAME }}"
identityProviders:
  - alias: google
    providerId: google
    enabled: true
    updateProfileFirstLoginMode: "on"
    trustEmail: true
    storeToken: false
    addReadTokenRoleOnCreate: false
    config:
      # TODO: We should template these in upon creating them with tf/tofu.
      clientId: "your-google-client-id"
      clientSecret: "your-google-client-secret"
      useUserIpParam: false
      userIp: ""
      hostedDomain: ""
      prompt: "unspecified"
      redirectUris:
        - "{{'https://{}/auth/realms/{}/broker/google/endpoint'.format(SPEZI_SERVICE_FQDN, SPEZI_SERVICE_NAME)}}"
      defaultScopes: "openid profile email" 
    postBrokerLoginFlowAlias: ""
    firstBrokerLoginFlowAlias: ""