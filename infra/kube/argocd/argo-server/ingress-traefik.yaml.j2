apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: oauth2-proxy-argo
  namespace: {{ spezi_service_name }}
spec:
  forwardAuth:
    address: http://oauth2-proxy.{{ spezi_service_name }}.svc.cluster.local/oauth2/auth?allowed_groups=ArgoCDAdmins
    trustForwardHeader: true
    authResponseHeaders: []
    authRequestHeaders: []
---
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: oauth2-errors
  namespace: {{ spezi_service_name }}
spec:
  errors:
    status:
      - 401-403
    service:
      name: oauth2-proxy
      port: 80
    query: "/oauth2/sign_in?rd={url}"
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: argocd-ingress
  namespace: {{ spezi_service_name }}
  annotations:
    cert-manager.io/cluster-issuer: "letsencrypt-prod"
spec:
  entryPoints:
    - websecure
  routes:
    - kind: Rule
      match: Host(`{{ spezi_service_fqdn }}`) && PathPrefix(`/argo`)
      middlewares:
        - name: oauth2-proxy
        - name: oauth2-errors
      priority: 10
      services:
        - name: argocd-server
          port: 80
    - kind: Rule
      match: Host(`{{ spezi_service_fqdn }}`) && PathPrefix(`/argo`) && Header(`Content-Type`, `application/grpc`)
      middlewares:
        - name: oauth2-proxy
        - name: oauth2-errors
      priority: 11
      services:
        - name: argocd-server
          port: 80
          scheme: h2c
  tls:
    secretName: {{ spezi_service_name }}-tls-secret