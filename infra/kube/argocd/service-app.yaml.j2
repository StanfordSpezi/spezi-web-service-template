apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ spezi_service_name }}
  namespace: {{ spezi_service_name }}
spec:
  project: default
  source:
    repoURL: {{ spezi_service_repo_url }}
    path: .
    targetRevision: main
    directory:
      recurse: true
      jsonnet: {}
      exclude: '*.json'
  destination:
    server: https://kubernetes.default.svc
  syncPolicy:
    syncOptions:
      - RespectIgnoreDifferences=true
      - ServerSideApply=true
    retry:
      limit: 2
      backoff:
        duration: 5s
        factor: 2
        maxDuration: 3m0s
